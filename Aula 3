#include <stdio.h>

int main()
{
    int v[8] = {6,5,3,1,8,7,2,4}; int n = 8;
    // Exercício 1 - Exibir o vetor nesse formato [6][5][3][1][8][7][2][4]
    for (int i = 0; i < n; i++){
        printf("%d", v[i] );
    }
    printf("\n");
    
    // Exercício 2 - Exibir o vetor do fim pro início, apenas o números ímpares,
    // no seguinte formato: [7][1][3][5]
    for (int i= n-1; i >= 0; i--){
        if (v[i] % 2 != 0){
            printf("%d", v[i]);
        }
    }
    printf("\n");
    return 0;
}


