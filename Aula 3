#include <stdio.h>

void divisao(float *p, float *p2){
    float x, y, z;
    x = *p;
    y = *p2;
    z = x/y;
    if(y==0){
        printf("Não existe divisão por zero!!");
    }else{
        printf("%f", z);
    }
}
int main(){
    float x, y;
    printf("Digite um número inteiro:\n");
    scanf("%f", &x);
    while(getchar() != '\n');
    printf("Digite um número inteiro para fazer a divisão:\n");
    scanf("%f", &y);
    divisao(&x, &y);
    return 0;
}
