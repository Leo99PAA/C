#include <stdio.h>

int main()
{
    int v[8] = {6,5,3,1,8,7,2,4}; int n = 8;
    // Exercício 1 - Exibir o vetor nesse formato [6][5][3][1][8][7][2][4]
    for (int i = 0; i < n; i++){
        printf("[%d]", v[i] );
    }
    printf("\n");
    
    // Exercício 2 - Exibir o vetor do fim pro início, apenas o números ímpares,
    // no seguinte formato: [7][1][3][5]
    for (int i= n-1; i >= 0; i--){
        if (v[i] % 2 != 0){
            printf("[%d]", v[i]);
        }
    }
    printf("\n");
    
    char str[50] = "Aula de APC II";
    // Exercício 3 - Exibir a string substituindo vogais por #
    // Saída esperada: ##l# d# #PC ##
    for (int i = 0; str[i] != '\0'; i++){
        if (str [i] == 'a' || str [i] == 'A' || str [i] == 'e' || str [i] == 'E' 
        || str [i] == 'i'
        || str [i] == 'I' || str [i] == 'o' || str [i] == 'O' || str [i] == 'u' 
        || str [i] == 'U'){
        printf("#");
        }else{
        printf("%c", str[i]);
        }
    }
    printf("\n");
    
    //código com while
    
    int i = 0;
    while (str[i] != '\0'){
        if (str [i] == 'a' || str [i] == 'A' || str [i] == 'e' || str [i] == 'E' 
        || str [i] == 'i'
        || str [i] == 'I' || str [i] == 'o' || str [i] == 'O' || str [i] == 'u' 
        || str [i] == 'U'){
        printf("#");
        }else{
        printf("%c", str[i]);
        }
        i++;
    }
    printf("\n");
    // usando switch case
    
    i = 0;
    while (str[i] != '\0'){
        switch(str[i]){
            case 'A': case 'a':
            case 'E': case 'e':
            case 'I': case 'i':
            case 'O': case 'o':
            case 'U': case 'u':
            printf("#");
            break;
        default:
            printf("%c", str[i]);
            break;
        }
    i++;
    }
    return 0;
}
